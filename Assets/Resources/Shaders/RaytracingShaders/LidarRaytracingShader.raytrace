#include "HLSLSupport.cginc"
#include "UnityShaderVariables.cginc"
#include "Assets/Scripts/CustomPass/Lidar/RayPayload.hlsl"
#include "Assets/Resources/Shaders/RaytracingShaders/LidarEnvironment.hlsl"

#pragma max_recursion_depth 10
//#pragma enable_ray_tracing_shader_debug_symbols

// Input
RaytracingAccelerationStructure _RaytracingAccelerationStructure;
float4 originPos;
float4x4 g_InvViewMatrix;
float4 lidarAngles; // x/y = min/max vertical angle, z/w = min/max horizontal angle (radians, 0 = look direction)
float projectionMode; // 0 = spherical (LiDAR), 1 = pinhole (depth camera)
float4x4 g_ExportMatrix; // world -> exported coordinates (identity for world, or the camera frame)

// Output
RWTexture2D<float4> worldPosTexture;
RWTexture2D<float4> worldColorTexture;

[shader("miss")]
void MainMissShader1_Primary(inout RayPayload payload : SV_RayPayload)
{
    //payload.color = float4(0,0,0,1);
    payload.worldPos.w = 0;
}


[shader("raygeneration")]
void MainRayGenShader()
{ 
	uint2 LaunchIndex = DispatchRaysIndex().xy;
    uint2 LaunchDim = DispatchRaysDimensions().xy;
    //float2 screenCo = float2(LaunchIndex.x, LaunchDim.y - LaunchIndex.y - 1) - float2(0.5,0.5);
    
    float3 viewDirection;
    // Sample at pixel centres so min and max angles are the outer edges of the field of view
    float2 uv = ((float2)LaunchIndex + 0.5) / ((float2)LaunchDim);

    // Camera (view) space: the camera looks along -Z, +Y is up, +X is right.
    if (projectionMode > 0.5)
    {
        // Pinhole: even grid on the image plane at distance 1 (like the pixels of a depth camera)
        float x = lerp(tan(lidarAngles.z), tan(lidarAngles.w), uv.x);
        float y = lerp(tan(lidarAngles.x), tan(lidarAngles.y), uv.y);
        viewDirection = float3(x, y, -1.0);
    }
    else
    {
        // Spherical: equal angle steps (like a spinning LiDAR)
        // theta = elevation above the camera's forward plane, phi = angle to the right of the look direction.
        float theta = lerp(lidarAngles.x, lidarAngles.y, uv.y);
        float phi   = lerp(lidarAngles.z, lidarAngles.w, uv.x);
        viewDirection.x = cos(theta) * sin(phi);
        viewDirection.y = sin(theta);
        viewDirection.z = -cos(theta) * cos(phi);
    }

    // Rotate the ray from view space to world space.
    float3 rayDirection = normalize(mul((float3x3)g_InvViewMatrix, viewDirection));

    RayDesc ray;
    ray.Origin = originPos.xyz;
    ray.Direction = rayDirection;
    ray.TMin = 0;
    ray.TMax = 1e10f;
    
    RayPayload payload;        
	payload.color = SampleEnvironment(rayDirection);
    payload.worldPos = originPos;
	payload.bounceIndex = 0;
    
    TraceRay(_RaytracingAccelerationStructure, 0, 0xFF, 0, 1, 0, ray, payload);

    // Hits have w = 1, misses w = 0 (the exporter skips those)
    if (payload.worldPos.w > 0.5)
        payload.worldPos = float4(mul(g_ExportMatrix, float4(payload.worldPos.xyz, 1.0)).xyz, 1.0);

	worldPosTexture[LaunchIndex] = payload.worldPos;
    // Face textures are sampled as linear; the .ply needs sRGB bytes
    worldColorTexture[LaunchIndex] = float4(LinearToSrgb(payload.color.rgb), payload.color.a);
}
