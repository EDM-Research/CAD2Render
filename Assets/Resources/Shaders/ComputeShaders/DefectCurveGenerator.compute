// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel CSMain
#pragma multi_compile __ changeNormalMap
#pragma multi_compile __ changeMaskMap
#pragma multi_compile __ changeColor

RWTexture2D<float4> DefectMapInOut;

#if changeColor 
    RWTexture2D<float4> ColorMapInOut;
    float4 defectColor1;
    float4 defectColor2;
#endif
#if changeNormalMap
    RWTexture2D<float4> NormalMapInOut;
    float dentModifier;
#endif
#if changeMaskMap
    RWTexture2D<float4> MaskMapInOut;
    float metalicnessOffset;
#endif

float sharpness1;
float sharpness2;
float defectCutoff;

float2 defectWidth;
float2 defectLength;
float2 defectAngle;
float2 defectControlPointOffset;

struct curveGenerationSettings
{
    float2 width;
    float2 length;
    float2 angle;
    float2 controlPointOffset;
};

//forward declarations
#include "RandomGPU.hlsl"
#include "UnityConvertFunctions.hlsl"

// https://www.desmos.com/calculator/w2yiypfrod
float easeFunction(float distance, float defectWidth, float sharpness)
{
    float dif = abs(2 * defectWidth);
    if (dif < 0.0001)
        return 0;
    float sharpnessBoundAware = sharpness / dif;
    float boundCompensation = 0.05f * dif;
    float lower_sigmoid = 1 / (1 + exp(-sharpnessBoundAware * (distance + defectWidth + boundCompensation)));
    float upper_sigmoid = 1 / (1 + exp( sharpnessBoundAware * (distance - defectWidth - boundCompensation)));

    return saturate(sharpness*sharpness) * lower_sigmoid * upper_sigmoid;
}
float easeFunctionNormal(float distance, float defectWidth, float sharpness)
{
    float dif = abs(2 * defectWidth);
    if (dif < 0.0001)
        return 0;
    float sharpnessBoundAware = sharpness / dif;
    float boundCompensation = 0.05f * dif;
    float lower_sigmoid = 1 / (1 + exp(-sharpnessBoundAware * (distance + defectWidth + boundCompensation)));
    float upper_sigmoid = 1 / (1 + exp(sharpnessBoundAware * (distance - defectWidth - boundCompensation)));

    return sharpnessBoundAware * lower_sigmoid * upper_sigmoid * (upper_sigmoid - lower_sigmoid);
}

float2 bezier(float2 p0, float2 p1, float2 p2, float2 p3, float t)
{
    float u = 1.0 - t;
    float uu = u * u;
    float tt = t * t;

    return uu * u * p0 +
           3.0 * uu * t * p1 +
           3.0 * u * tt * p2 +
           tt * t * p3;
}

// derivative of cubic bezier: B'(t) = 3[(1-t)^2 (p1-p0) + 2(1-t)t (p2-p1) + t^2 (p3-p2)]
float2 bezierTangent(float2 p0, float2 p1, float2 p2, float2 p3, float t)
{
    float u = 1.0 - t;
    float a = u * u;
    float b = 2.0 * u * t;
    float c = t * t;

    return 3.0 * (a * (p1 - p0) + b * (p2 - p1) + c * (p3 - p2));
}

struct CurveInfo
{
    float distance;
    float t;

    float2 closestPoint;
    float2 toCurve;
    float side;
};

CurveInfo getCurveInfo(float2 uv, curveGenerationSettings settings, uint seed)
{
    //generate points of a curve
    float2 center = float2(nextRand(seed), nextRand(seed));

    float angle = lerp(settings.angle.x / 360.0, settings.angle.y / 360.0, nextRand(seed)) * PI * 2;
    float2 dir = float2(cos(angle), sin(angle));
    float2 perp = float2(-dir.y, dir.x);

    float curveLength = lerp(settings.length.x, settings.length.y, nextRand(seed));

    float2 p0 = center - dir * curveLength * 0.5;
    float2 p3 = center + dir * curveLength * 0.5;

    float2 p1 = lerp(p0, p3, 0.33) + perp * lerp(settings.controlPointOffset.x, settings.controlPointOffset.y, nextRand(seed)) * curveLength;
    float2 p2 = lerp(p0, p3, 0.66) + perp * lerp(settings.controlPointOffset.x, settings.controlPointOffset.y, nextRand(seed)) * curveLength;
    
    CurveInfo info;
    info.distance = 1e10;
    info.t = 0.0;
    info.closestPoint = 0;
    info.toCurve = float2(0, 1);

    float2 prev = bezier(p0, p1, p2, p3, 0.0);
    
    static const int STEPS = 200;
    [unroll]
    for (int i = 1; i <= STEPS; i++)
    {
        float t = (float) i / STEPS;
        float2 curr = bezier(p0, p1, p2, p3, t);

        float2 segment = curr - prev;
        float len2 = dot(segment, segment);

        if (len2 > 1e-8)
        {
            float h = saturate(dot(uv - prev, segment) / len2);

            float2 closest = prev + h * segment;
            float dist = distance(uv, closest);

            if (dist < info.distance)
            {
                info.distance = dist;
                info.closestPoint = closest;
                info.toCurve = normalize(uv - closest);

                // Approximate parameter on the Bezier
                info.t = ((float) (i - 1) + h) / STEPS;

                // compute local tangent and normal at the closest parameter
                float2 tangent = normalize(bezierTangent(p0, p1, p2, p3, info.t));

                float2 normal = float2(-tangent.y, tangent.x);
                info.side = dot(info.toCurve, normal);
            }
        }

        prev = curr;
    }

    return info;
}

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{   
    uint threadRandSeed = createThreadRandomSeed(id.xy, randSeed);
    uint startRandSeed = randSeed;
    int2 resolution; 
    DefectMapInOut.GetDimensions(resolution.x, resolution.y);
    
    curveGenerationSettings settings;
    settings.width = defectWidth * 10;
    settings.length = defectLength;
    settings.angle = defectAngle;
    settings.controlPointOffset = defectControlPointOffset;
    CurveInfo curveInfo = getCurveInfo((float2) id.xy / (float2) resolution, settings, startRandSeed);
    curveInfo.distance = curveInfo.distance * 10; // scale distance to pixel space
    float defectWidth = lerp(settings.width.x, settings.width.y, nextRand(startRandSeed));
    float sharpness = lerp(sharpness1, sharpness2, curveInfo.side/2 + 0.5f);
    float defectValue = easeFunction(curveInfo.distance, defectWidth, sharpness);

    
    #if changeColor
        float defectColorChange = FractalBrownianMotion(3, 0.1, 1.0, startRandSeed, id.xy, resolution);
        float4 oldColor = ColorMapInOut[id.xy];
        float4 newColor = lerp(defectColor1, defectColor2, saturate(defectColorChange));
        ColorMapInOut[id.xy] = float4(lerp(oldColor, newColor, newColor.a * defectValue).rgb, oldColor.a);//float4(curveInfo.toCurve/2+0.5, 0, 1.0);//
    #endif
    
    // if a == 1 -> no defect; else defect
    float4 defectMapValue = DefectMapInOut[id.xy];
    float cutoff = step(defectCutoff, defectValue);
    defectMapValue.a = defectMapValue.a * (1 - cutoff);
    DefectMapInOut[id.xy] = defectMapValue;
    
    #if changeMaskMap 
        float4 oldMask = MaskMapInOut[id.xy];
        oldMask.r += defectValue * metalicnessOffset; //metalicness
        oldMask.a *= 1 - defectValue * 0.4; //reduce smoothness
        MaskMapInOut[id.xy] = saturate(oldMask);
    #endif
    
    #if changeNormalMap 
        randSeed = startRandSeed;
        float normal = easeFunctionNormal(curveInfo.distance, defectWidth, sharpness);
        float3 defectNormalModifier = float3(curveInfo.toCurve, 0) * normal * dentModifier;
     
        float3 oldNormal = unpackNormal(NormalMapInOut[id.xy]);
        float3 newNormal = normalize(defectNormalModifier + oldNormal);
        newNormal = lerp(oldNormal, newNormal, defectValue * 0.5);
        NormalMapInOut[id.xy] = packNormal(newNormal);
#endif
}


